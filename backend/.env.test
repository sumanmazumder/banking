# ============================================================
# Banking Management System - BACKEND environment
# Automated tests - throwaway secrets, separate database (banking_test). Safe to commit.
# ============================================================

APP_ENV=test
NODE_ENV=test
PORT=5001
APP_NAME=Banking Management System
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000

# ---------- MySQL (local) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banking_test
# Use a dedicated app user (see README) - not root - once you are past first setup
DB_USER=banking_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Only used by 'npm run db:create' to create the database and app user (needs privileges)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# ---------- JWT (SRS section 10) ----------
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=banking-api
JWT_AUDIENCE=banking-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Max concurrent active sessions per user (open decision in SRS section 15)
MAX_ACTIVE_SESSIONS=5

# ---------- Cookies / CSRF / hashing ----------
COOKIE_SECRET=989367ee205e1cdbb26693fcbe7507403866a44f709f29d2fe1295929f4acd82
COOKIE_SECURE=false
CSRF_SECRET=08ab8800f384163372c3b8d4246a9fd32f6618139c85780a85403fee40f6c48f
# HMAC pepper for hashing refresh tokens and OTPs before storing in DB
TOKEN_HASH_PEPPER=428e4dfd6cd6cad7f385f9ac64a94bcf032b4706ac8a46d777ab4842cf0a76cf
# 32-byte hex key (AES-256-GCM) for encrypting KYC document references
DATA_ENCRYPTION_KEY=a43a8545119f5d62dd9fffe05cd216f92e1099fb28b701bbe0b442e00abc8014

# ---------- Email (dev default = Mailpit/Mailtrap style SMTP) ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Banking System <no-reply@localhost>"
# Production providers (fill when chosen): AWS SES / SendGrid / Brevo etc.
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Payments (Razorpay test mode by default) ----------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=1000

# ---------- Business timezone ----------
BUSINESS_TIMEZONE=Asia/Kolkata

# ---------- Seed super admin (change immediately) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345
